# DAM-SAFE Backend Environment Configuration
# Copy this file to .env and configure your local PostgreSQL + PostGIS credentials

# Database Connection Settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dam_safe
DB_USER=postgres
DB_PASSWORD=postgres

# Combined Database URL (SQLAlchemy format)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dam_safe

# Application Mode
PROTOTYPE_MODE=True
